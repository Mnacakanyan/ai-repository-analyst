# ==============================================================================
# AI Repository Analyst - Environment Configuration
# ==============================================================================

# Primary LLM API Key (Anthropic Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Secondary LLM API Key (OpenAI GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...

# Optional: GitHub Personal Access Token
# Public repos work without a token (60 req/hr). Setting a token increases rate limit to 5,000 req/hr.
GITHUB_TOKEN=ghp_...

# Default Provider & Model Configuration
DEFAULT_PROVIDER=anthropic
DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DEFAULT_OPENAI_MODEL=gpt-4o

# Agent Guardrails & Boundaries
MAX_TURNS=15
MAX_TOTAL_COST_USD=1.50
MAX_FILE_READ_BYTES=60000
MAX_TREE_ITEMS=300
OUTPUT_DIR=reports
